{
  "title": "RabbitMQ",
  "uid": "rabbitmq",
  "schemaVersion": 16,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Queue Depth (Ready Messages) by Queue",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rabbitmq_detailed_queue_messages_ready", "format": "table", "instant": true }
      ]
    },
    {
      "id": 2,
      "title": "Unacknowledged Messages by Queue",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        { "expr": "rabbitmq_detailed_queue_messages_unacked", "format": "table", "instant": true }
      ]
    },
    {
      "id": 3,
      "title": "Consumers per Queue",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "expr": "rabbitmq_detailed_queue_consumers", "format": "table", "instant": true }
      ]
    },
    {
      "id": 4,
      "title": "Connections / Channels (cluster-wide)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rabbitmq_connections", "legendFormat": "connections" },
        { "expr": "rabbitmq_channels", "legendFormat": "channels" },
        { "expr": "rabbitmq_consumers", "legendFormat": "consumers" }
      ]
    },
    {
      "id": 5,
      "title": "Message Throughput (cluster-wide)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "description": "No per-queue delivery/ack metric exists in RabbitMQ's Prometheus plugin — these global counters are the correct source for throughput.",
      "targets": [
        { "expr": "rate(rabbitmq_global_messages_received_total[5m])", "legendFormat": "received" },
        { "expr": "rate(rabbitmq_global_messages_delivered_total[5m])", "legendFormat": "delivered" },
        { "expr": "rate(rabbitmq_global_messages_acknowledged_total[5m])", "legendFormat": "acknowledged" },
        { "expr": "rate(rabbitmq_global_messages_redelivered_total[5m])", "legendFormat": "redelivered" }
      ]
    },
    {
      "id": 6,
      "title": "Dead-Lettered Messages",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "description": "Jobs that failed processing and were routed to chat.title_generation.dlq — should stay flat at zero in normal operation.",
      "targets": [
        {
          "expr": "sum(rate(rabbitmq_global_messages_dead_lettered_rejected_total[5m])) by (queue_type)",
          "legendFormat": "rejected ({{queue_type}})"
        },
        {
          "expr": "sum(rate(rabbitmq_global_messages_dead_lettered_expired_total[5m])) by (queue_type)",
          "legendFormat": "expired ({{queue_type}})"
        }
      ]
    },
    {
      "id": 7,
      "title": "Broker Memory & Disk",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "rabbitmq_process_resident_memory_bytes / 1024 / 1024", "legendFormat": "memory MiB" },
        { "expr": "rabbitmq_disk_space_available_bytes / 1024 / 1024 / 1024", "legendFormat": "disk free GiB" }
      ]
    },
    {
      "id": 8,
      "title": "Broker Disk I/O",
      "type": "graph",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        { "expr": "rate(rabbitmq_io_read_bytes_total[5m])", "legendFormat": "read bytes/sec" },
        { "expr": "rate(rabbitmq_io_write_bytes_total[5m])", "legendFormat": "write bytes/sec" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "id": 9,
      "title": "Title-Generation Worker: Job Outcomes",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "description": "worker_title_jobs_total from ai-agent-worker itself — actual consumer success/failure, not just queue depth.",
      "targets": [
        { "expr": "sum(rate(worker_title_jobs_total[5m])) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 10,
      "title": "Title-Generation Worker: Job Duration (P95)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(worker_title_job_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 duration"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}