{
  "title": "AI Generation Performance",
  "uid": "ollama",
  "schemaVersion": 16,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Active Generations",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "agent_generation_active", "legendFormat": "in flight" }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate (5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(agent_generation_requests_total{status=\"error\"}[5m])) / sum(rate(agent_generation_requests_total[5m])) * 100",
          "legendFormat": "Error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Generation Requests by Model",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(agent_generation_requests_total[5m])) by (model, status)",
          "legendFormat": "{{model}} ({{status}})"
        }
      ]
    },
    {
      "id": 4,
      "title": "Token Throughput by Model",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(agent_generation_tokens_total[5m])) by (model, type)",
          "legendFormat": "{{model}} ({{type}})"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "tps" }
      }
    },
    {
      "id": 5,
      "title": "Generation Duration (P50 / P95 / P99)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(agent_generation_duration_seconds_bucket[5m])) by (le, model))",
          "legendFormat": "p50 {{model}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_generation_duration_seconds_bucket[5m])) by (le, model))",
          "legendFormat": "p95 {{model}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(agent_generation_duration_seconds_bucket[5m])) by (le, model))",
          "legendFormat": "p99 {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    }
  ]
}