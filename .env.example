# ============================================
# Copy this file to ".env" and fill in the real values.
#   cp .env.example .env
# Never commit the real ".env" file — it's already in .gitignore.
# ============================================

# ------------------------------------------------
# Database — you can leave these as-is for a first
# install. They're only used between containers on
# your own machine, nothing external touches them.
# ------------------------------------------------
POSTGRES_USER=aichat
POSTGRES_PASSWORD=change-me-to-something-random
POSTGRES_DB=ai-agent

# ------------------------------------------------
# Message queue — same as above, safe to leave as-is.
# ------------------------------------------------
RABBITMQ_USER=aichat
RABBITMQ_PASSWORD=change-me-to-something-random

# ------------------------------------------------
# Cache
# ------------------------------------------------
REDIS_PASSWORD=change-me-to-something-random

# ------------------------------------------------
# Dashboards (optional, only used if you visit the
# Grafana monitoring page)
# ------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-to-something-random

# ------------------------------------------------
# How much each person can chat before being
# rate-limited. Numbers are in "tokens" (roughly:
# words of AI output). Defaults are generous for
# personal/small-group use.
# ------------------------------------------------
TOKEN_LIMIT_5H=50000
TOKEN_LIMIT_DAILY=200000
TOKEN_LIMIT_WEEKLY=1000000

# ------------------------------------------------
# Google Sign-In — see "Setting up Google Sign-In"
# in the README for how to get these two values.
# ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------
# Email — used only to send login verification codes.
# If you use Gmail, EMAIL_PASSWORD must be a Gmail
# "App Password", not your normal Gmail password.
# Google: Account → Security → 2-Step Verification
# → App Passwords.
# ------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# ------------------------------------------------
# Security keys — these protect login sessions and
# internal service-to-service requests. Generate
# your own random values, don't reuse the ones from
# any example or tutorial you find online.
#
# If you have a terminal, generate one with:
#   openssl rand -hex 32
# Run it twice — JWT_SECRET and API_KEY should be
# two DIFFERENT random values, not the same one.
#
# No terminal? Any long (32+ character) random mix
# of letters and numbers works — a password
# manager's "generate password" button is fine too.
# ------------------------------------------------
JWT_SECRET=
API_KEY=

# ------------------------------------------------
# The AI model provider — see "Setting up Ollama"
# in the README.
# ------------------------------------------------
OLLAMA_API_KEY=

# ------------------------------------------------
# development / production
# ------------------------------------------------
ENVIRONMENT=development
