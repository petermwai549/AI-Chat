# ============================================
# Copy this file to "frontend/.env" and fill in the
# values (they should match what you put in the root
# .env file, for GOOGLE_CLIENT_ID and API_KEY).
#   cp frontend/.env.example frontend/.env
# ============================================

# The address the app talks to for everything (login,
# sending messages, etc). Leave this as-is for a
# standard local install.
VITE_API_ORIGIN=http://localhost:6080

# Must match API_KEY in the root .env file.
VITE_API_KEY=

# Must match GOOGLE_CLIENT_ID in the root .env file.
VITE_GOOGLE_CLIENT_ID=

# Which AI model to use by default.
VITE_DEFAULT_MODEL=gpt-oss:20b
